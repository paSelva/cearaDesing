# Modelo de produção. Copie para .env somente no servidor e preencha em privado.
# Nunca coloque segredos no Git, no ZIP, no chat, no Cron ou em capturas de tela.

APP_NAME="Prêmio Ceará Tem Design"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://DOMINIO_FINAL
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Use os nomes completos exibidos pelo cPanel (normalmente PREFIXO_nome).
# DB_HOST deve ser exatamente o informado pela hospedagem; não use o serviço Docker "mysql".
# Produção informou Percona Server 5.7.44-48, validado localmente com a imagem oficial.
# MySQL 8 também tem histórico de testes; MariaDB permanece bloqueado até teste específico.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database

# O código atual não despacha jobs: sync evita depender de worker no cPanel.
QUEUE_CONNECTION=sync

# Todos os uploads atuais ficam em storage/app/private e são servidos por rotas autorizadas.
FILESYSTEM_DISK=local

# "log" NÃO entrega mensagens: serve apenas para diagnóstico e deixa recuperação de senha
# indisponível. Após obter SMTP, use MAIL_MAILER=smtp e preencha/teste os campos abaixo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Prêmio Ceará Tem Design"

# Obrigatórias na release atual para o cadastro de eleitor.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Gere uma única vez com fonte criptográfica e preserve em toda atualização/rollback.
# Trocar esta chave altera os hashes usados para impedir CPF duplicado.
CPF_HMAC_KEY=
