# Modelo do .env de PRODUÇÃO (votacao.cearadesign.org.br — P62).
# Copiar para /home/USUARIO/votacao/.env no servidor (permissão 600 ou 640) e preencher.
# Os valores secretos NUNCA vão para o Git, o chat ou uma linha de cron.

APP_NAME="Prêmio Ceará Tem Design"
APP_ENV=production
# Gerar na sua máquina: docker compose -p ceara_spec002_dev exec laravel.test php artisan key:generate --show
# Guardar num gerenciador de senhas. Trocar depois quebra sessões e o CPF criptografado dos eleitores.
APP_KEY=
APP_DEBUG=false
APP_URL=https://votacao.cearadesign.org.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Banco criado no cPanel (MySQL Databases). Usuário com privilégios só neste banco.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sem Redis na hospedagem compartilhada (docs/02).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

# ⚠️ P31: sem provedor de e-mail, a recuperação de senha só grava o link no log.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@cearadesign.org.br"
MAIL_FROM_NAME="Prêmio Ceará Tem Design"

# Cloudflare Turnstile (P52), widget criado para votacao.cearadesign.org.br.
# Sem estas chaves, o cadastro de eleitor fica indisponível.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Gerar uma vez na sua máquina: openssl rand -hex 32. NUNCA trocar depois (P35).
CPF_HMAC_KEY=