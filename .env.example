APP_NAME="Ceará Tem Design"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_PORT=8081
WWWUSER=1000
WWWGROUP=1000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ceara_spec000_local
DB_TEST_DATABASE=ceara_spec000_testing
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=33060

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="Ceará Tem Design"

# Cloudflare Turnstile do cadastro de eleitor (P52). Sem chaves, o cadastro fica indisponível.
# Chaves de teste só para desenvolvimento: ver docs/qa/SPEC-009-handoff.md. Nunca em produção.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Chave do HMAC do CPF do eleitor (P35): gerar uma vez (ex.: openssl rand -hex 32) e NUNCA trocar.
CPF_HMAC_KEY=
